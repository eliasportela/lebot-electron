{
  "name": "lebot-desk",
  "productName": "LebotDesk",
  "version": "1.0.2",
  "description": "Lebot Desk - Sistema de chamados",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "app.lecard.lebotdesk",
    "publish": [
      {
        "provider": "github",
        "owner": "eliasportela",
        "repo": "lebot-electron",
        "releaseType": "release"
      }
    ],
    "files": [
      "**/*",
      "!.env",
      "!.env.*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "LebotDesk-${version}.exe"
    }
  },
  "dependencies": {
    "electron-config": "^1.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2"
  }
}
